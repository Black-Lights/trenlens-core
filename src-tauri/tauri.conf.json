{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrenLens Core",
  "version": "0.1.0",
  "identifier": "com.trenlens.core",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TrenLens Core",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "transparent": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; connect-src 'self' ipc: http://localhost:* https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/litellm-proxy"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
